//variavel pra guardar a velocidade da bola;
global.vspeed_bola = 0;

//variavel pra guardar o modo de jogo
global.dois_jogadores = 0;

//variaveis de pontos dos jogadores
global.gols_jogador_1 = 0;
global.gols_jogador_2 = 0;
//variavel que define a quantidade de gols maxima
global.gols_max = 3;
//variavel pra saber qual foi o ultimo a tocar na bola
global.p1_ultimo = false;

//variavel para definir a dificuldade true pra dificil e false pra normal
global.dificuldade = false;